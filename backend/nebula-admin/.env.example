APP_NAME=Nebula Admin
APP_VERSION=0.1.0-dev
APP_ENV=development

# Admin JWT (identidade administrativa — separada da identidade de Device)
ADMIN_JWT_SECRET_KEY=change-me-please
ADMIN_JWT_ISSUER=nebula-admin
ADMIN_JWT_AUDIENCE=nebula-admin-ui
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comunicação service-to-service com o Nebula Core
NEBULA_CORE_BASE_URL=http://localhost:8000
NEBULA_CORE_SERVICE_TOKEN=dev-admin-key

# Administrador de bootstrap (primeira identidade administrativa)
ADMIN_SEED_EMAIL=admin@nebula.local
ADMIN_SEED_PASSWORD=change-me-please
ADMIN_SEED_ROLE=super_admin
