{
  "name": "nebula-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Nebula TV — app para LG Smart TV (webOS)",
  "scripts": {
    "test": "node test/m3u.test.js && node test/search.test.js && node test/structure.test.js",
    "device:add": "ares-setup-device",
    "device:list": "ares-setup-device --list",
    "device:info": "ares-device-info -d tv",
    "package": "ares-package . -o dist",
    "install:tv": "ares-install dist/com.nebula.tv_0.1.0_all.ipk -d tv",
    "launch": "ares-launch com.nebula.tv -d tv",
    "close": "ares-launch --close com.nebula.tv -d tv",
    "inspect": "ares-inspect com.nebula.tv -d tv"
  },
  "webosCli": {
    "instalada": "@webos-tools/cli (global)",
    "instalar": "npm install -g @webos-tools/cli"
  }
}
